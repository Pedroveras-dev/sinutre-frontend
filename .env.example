# Copie para .env. Valores ilustrativos.
#
# ATENÇÃO: toda variável VITE_* é embutida no JavaScript público do site.
# Nunca coloque segredos aqui (client secret, JWT secret, senha de banco).

# URL do backend (sinutre-backend), sem barra no final.
# Local:    http://localhost:3333
# Produção: https://SEU-BACKEND.onrender.com
VITE_API_URL=http://localhost:3333
